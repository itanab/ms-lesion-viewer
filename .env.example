# Copy to .env and export (or pass to docker compose). All variables are optional.
MSLV_DATA_ROOT=./data                 # SQLite + case files live here (gitignored)
# Limits (spec defaults; max voxels raised to 64M for full-resolution open_ms_data scans)
MSLV_MAX_UPLOAD_BYTES=268435456
MSLV_MAX_DECOMPRESSED_BYTES=536870912
MSLV_MAX_VOXELS=64000000
MSLV_MAX_WORKING_MEMORY_BYTES=2147483648
# Inference: none | mock | package.module:factory
MSLV_ADAPTER=none
MSLV_ADAPTER_CONFIG={}
MSLV_ENABLE_MOCK=0                    # the mock adapter only runs when this is 1 (demo/test only)
MSLV_DEVICE=cpu                       # cpu | cuda:0 ...
MSLV_JOB_TIMEOUT_S=1800
